    scaler,
    threshold
):

    print("\n")
    print("=" * 65)
    print("DEMO MACHINE PREDICTIONS")
    print("=" * 65)

    test_cases = {

        "Normal Machine": [
            70,
            0.35,
            100,
            20,
            1500,
            50,
            40
        ],

        "Overheating Machine": [
            102,
            1.20,
            130,
            34,
            1150,
            80,
            75
        ],

        "High Vibration Machine": [
            88,
            1.40,
            118,
            30,
            1250,
            70,
            68
        ]

    }

    columns = [
        "temperature",
        "vibration",
        "pressure",
        "motor_current",
        "rotation_speed",
        "humidity",
        "acoustic_level"
    ]

    for name, values in test_cases.items():

        machine = pd.DataFrame(
            [values],
            columns=columns
        )

        scaled = scaler.transform(
            machine
        )

        reconstructed = model.predict(
            scaled
        )

        error = np.mean(
            np.square(
                scaled -
                reconstructed
            )
        )

        if error > threshold:

            status = "ANOMALY"

        else:

            status = "NORMAL"

        print(
            f"\n{name}"
        )

        print(
            f"Reconstruction Error: "
            f"{error:.6f}"
        )

        print(
            f"Prediction: {status}"
        )


