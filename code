            input(
                "Motor Current: "
            )
        )

        rotation_speed = float(
            input(
                "Rotation Speed: "
            )
        )

        humidity = float(
            input(
                "Humidity: "
            )
        )

        acoustic_level = float(
            input(
                "Acoustic Level: "
            )
        )

    except ValueError:

        print(
            "\nInvalid input."
        )

        return

    values = pd.DataFrame(

        [[
            temperature,
            vibration,
            pressure,
            motor_current,
            rotation_speed,
            humidity,
            acoustic_level
        ]],

        columns=[
            "temperature",
            "vibration",
            "pressure",
            "motor_current",
            "rotation_speed",
            "humidity",
            "acoustic_level"
        ]
    )

    scaled_values = scaler.transform(
        values
    )

    reconstruction = model.predict(
        scaled_values
    )

    error = np.mean(
        np.square(
            scaled_values -
            reconstruction
        )
    )

    print("\n")
    print("=" * 65)
    print("MACHINE CONDITION RESULT")
    print("=" * 65)

    print(
        f"\nReconstruction Error: "
        f"{error:.6f}"
    )

    print(
        f"Anomaly Threshold: "
        f"{threshold:.6f}"
    )

    if error > threshold:

        print(
            "\nStatus: ANOMALY DETECTED"
        )

        print(
            "Recommendation: Inspect the machine."
        )

    else:

        print(
            "\nStatus: NORMAL"
        )

        print(
            "Machine appears to be operating normally."
        )


