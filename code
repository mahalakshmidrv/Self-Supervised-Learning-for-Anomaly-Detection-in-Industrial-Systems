        )
    )

    print(
        "\nSample data:"
    )

    print(
        data.head()
    )


# ============================================================
# 3. PREPARE DATA
# ============================================================

def prepare_data(data):

    features = [
        "temperature",
        "vibration",
        "pressure",
        "motor_current",
        "rotation_speed",
        "humidity",
        "acoustic_level"
    ]

    X = data[
        features
    ]

    y = data[
        "actual_status"
    ]

    # --------------------------------------------------------
    # IMPORTANT SELF-SUPERVISED IDEA
    # --------------------------------------------------------
    #
    # The autoencoder is trained ONLY using normal samples.
    #
    # The anomaly labels are NOT used during training.
    #
    # --------------------------------------------------------

    normal_data = X[
        y == 0
    ]

    scaler = StandardScaler()

    normal_scaled = scaler.fit_transform(
        normal_data
    )

    all_scaled = scaler.transform(
        X
    )

    return (
        normal_scaled,
        all_scaled,
        y,
        scaler,
        features
    )


# ============================================================
# 4. CREATE SELF-SUPERVISED AUTOENCODER
# ============================================================

def create_autoencoder():

    model = MLPRegressor(

        hidden_layer_sizes=(
            16,
            8,
            16
        ),

        activation="relu",

        solver="adam",

        learning_rate_init=0.001,

        max_iter=300,

        random_state=RANDOM_STATE,

        early_stopping=True,

        validation_fraction=0.15,

        verbose=False

    )

    return model


# ============================================================
# 5. TRAIN MODEL
# ============================================================

def train_model(
    normal_data
):

    print("\n")
    print("=" * 65)
    print("SELF-SUPERVISED MODEL TRAINING")
    print("=" * 65)

    print(
        "\nTraining only on normal operating data..."
    )

    model = create_autoencoder()

    # --------------------------------------------------------
    # Autoencoder learns:
    #
    # Input → compressed representation → reconstruction
    #
    # Normal patterns are reconstructed well.
    # Anomalies usually produce larger reconstruction errors.
    # --------------------------------------------------------

    model.fit(
        normal_data,
        normal_data
    )

    print(
        "\nTraining completed."
    )

    return model


# ============================================================
# 6. CALCULATE RECONSTRUCTION ERROR
# ============================================================

def calculate_reconstruction_error(
    model,
    data
):

    reconstructed = model.predict(
        data
    )

    error = np.mean(
        np.square(
            data - reconstructed
        ),
        axis=1
    )

    return error


# ============================================================
# 7. DETERMINE ANOMALY THRESHOLD
# ============================================================

def calculate_threshold(
    model,
    normal_data
):

    normal_errors = calculate_reconstruction_error(
        model,
        normal_data
    )

    # --------------------------------------------------------
    # 95th percentile threshold
    # --------------------------------------------------------

    threshold = np.percentile(
        normal_errors,
        95
    )

    print("\n")
    print("=" * 65)
    print("ANOMALY THRESHOLD")
    print("=" * 65)

    print(
        f"\nThreshold: {threshold:.6f}"
    )

    print(
        "\nRecords with reconstruction error"
        " above this threshold are considered anomalous."
    )

    return threshold


# ============================================================
# 8. DETECT ANOMALIES
# ============================================================

def detect_anomalies(
    errors,
    threshold
):

    predictions = (
        errors > threshold
    ).astype(int)

    return predictions


# ============================================================
# 9. EVALUATE MODEL
# ============================================================

def evaluate_model(
    actual,
    predicted
):

    accuracy = accuracy_score(
        actual,
        predicted
    )

    precision = precision_score(
        actual,
        predicted,
        zero_division=0
    )

    recall = recall_score(
        actual,
        predicted,
        zero_division=0
    )

    f1 = f1_score(
        actual,
        predicted,
        zero_division=0
    )

    cm = confusion_matrix(
        actual,
        predicted
    )

    print("\n")
    print("=" * 65)
    print("ANOMALY DETECTION EVALUATION")
    print("=" * 65)

    print(
        f"\nAccuracy  : {accuracy * 100:.2f}%"
    )

    print(
        f"Precision : {precision * 100:.2f}%"
    )

    print(
        f"Recall    : {recall * 100:.2f}%"
    )

    print(
        f"F1 Score  : {f1 * 100:.2f}%"
    )

    print(
        "\nConfusion Matrix:"
    )

    print(cm)

    print(
        "\n0 = Normal"
    )

    print(
        "1 = Anomaly"
    )

    return cm


