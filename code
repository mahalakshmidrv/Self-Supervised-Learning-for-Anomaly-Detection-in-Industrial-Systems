import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.neural_network import MLPRegressor
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix
)


# ============================================================
# CONFIGURATION
# ============================================================

TOTAL_SAMPLES = 3000
ANOMALY_RATIO = 0.15
RANDOM_STATE = 42

np.random.seed(RANDOM_STATE)


# ============================================================
# 1. GENERATE SYNTHETIC INDUSTRIAL SENSOR DATA
# ============================================================

def generate_industrial_data():

    normal_samples = int(
        TOTAL_SAMPLES * (1 - ANOMALY_RATIO)
    )

    anomaly_samples = (
        TOTAL_SAMPLES - normal_samples
    )

    # --------------------------------------------------------
    # NORMAL OPERATING DATA
    # --------------------------------------------------------

    temperature = np.random.normal(
        70,
        4,
        normal_samples
    )

    vibration = np.random.normal(
        0.35,
        0.08,
        normal_samples
    )

    pressure = np.random.normal(
        100,
        5,
        normal_samples
    )

    motor_current = np.random.normal(
        20,
        2,
        normal_samples
    )

    rotation_speed = np.random.normal(
        1500,
        70,
        normal_samples
    )

    humidity = np.random.normal(
        50,
        5,
        normal_samples
    )

    acoustic_level = np.random.normal(
        40,
        4,
        normal_samples
    )

    # --------------------------------------------------------
    # ANOMALOUS DATA
    # --------------------------------------------------------

    anomaly_temperature = np.random.normal(
        95,
        8,
        anomaly_samples
    )

    anomaly_vibration = np.random.normal(
        1.10,
        0.20,
        anomaly_samples
    )

    anomaly_pressure = np.random.normal(
        125,
        12,
        anomaly_samples
    )

    anomaly_motor_current = np.random.normal(
        32,
        5,
        anomaly_samples
    )

    anomaly_rotation_speed = np.random.normal(
        1200,
        180,
        anomaly_samples
    )

    anomaly_humidity = np.random.normal(
        75,
        10,
        anomaly_samples
    )

    anomaly_acoustic_level = np.random.normal(
        70,
        10,
        anomaly_samples
    )

    # --------------------------------------------------------
    # COMBINE NORMAL + ANOMALY DATA
    # --------------------------------------------------------

    data = pd.DataFrame({

        "temperature": np.concatenate([
            temperature,
            anomaly_temperature
        ]),

        "vibration": np.concatenate([
            vibration,
            anomaly_vibration
        ]),

        "pressure": np.concatenate([
            pressure,
            anomaly_pressure
        ]),

        "motor_current": np.concatenate([
            motor_current,
            anomaly_motor_current
        ]),

        "rotation_speed": np.concatenate([
            rotation_speed,
            anomaly_rotation_speed
        ]),

        "humidity": np.concatenate([
            humidity,
            anomaly_humidity
        ]),

        "acoustic_level": np.concatenate([
            acoustic_level,
            anomaly_acoustic_level
        ]),

        "actual_status": np.concatenate([
            np.zeros(normal_samples),
            np.ones(anomaly_samples)
        ])

    })

    # Shuffle data

    data = data.sample(
        frac=1,
        random_state=RANDOM_STATE
    ).reset_index(
        drop=True
    )

    return data


# ============================================================
# 2. DISPLAY DATASET
# ============================================================

def display_dataset(data):

    print("\n")
    print("=" * 65)
    print("INDUSTRIAL SENSOR DATA")
    print("=" * 65)

    print(
        "\nTotal sensor records:",
        len(data)
    )

    print(
